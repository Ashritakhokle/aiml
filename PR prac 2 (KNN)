import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.linear_model import LogisticRegression

# Load iris dataset
iris = load_iris()
X = iris.data[:, [0, 2]]  # Sepal length (0), Petal length (2)
y = iris.target

# Keep only Setosa (0) and Versicolor (1)
mask = y < 2
X = X[mask]
y = y[mask]

# Fit logistic regression
clf = LogisticRegression().fit(X, y)

w = clf.coef_[0]
b = clf.intercept_[0]

# Decision boundary
x_vals = np.linspace(X[:, 0].min() - 0.5, X[:, 0].max() + 0.5, 100)
y_vals = -(w[0] / w[1]) * x_vals - (b / w[1])

# Plot
plt.figure(figsize=(4, 4))
plt.scatter(X[y == 0, 0], X[y == 0, 1], facecolors='none', edgecolors='blue', s=60, label='Setosa')
plt.scatter(X[y == 1, 0], X[y == 1, 1], c='green', marker='x', s=60, label='Versicolor')

plt.plot(x_vals, y_vals)

plt.title("Iris: Setosa vs Versicolor")
plt.xlabel("Sepal length (cm)")
plt.ylabel("Petal length (cm)")
plt.legend(frameon=False)
plt.tight_layout()
plt.show()
